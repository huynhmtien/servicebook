# Used when you run locally (copy to .dev.vars) and as the list of secrets the "Deploy to Cloudflare" button asks for.
# Language, currency, units, tax label, time zone, reminder hour: Settings page in the app.
# AI keys (Gemini / Anthropic / DeepSeek) and Telegram token + chat id: also pasted in the app, Settings -> Integrations & API keys.

# The password you sign in with (can be changed later in Settings -> Password)
APP_PASSWORD=
# Any long random text (40+ characters). Signs login sessions, encrypts API keys saved in the app. openssl rand -hex 32
SESSION_SECRET=
